;;; Rational Arithmetic: exact fractional number library
;;; Implements a rational number (fraction) data type with canonical normalization
;;; and exact arithmetic operations.

;;; Internal representation: a rational is a two-element list [numerator denominator]
;;; Canonical form: denominator is always positive, sign is carried on numerator,
;;; and the fraction is fully reduced via gcd.

(define (make-rat n d)
  "Create a rational number from numerator n and denominator d.
   The result is stored in canonical form: reduced to lowest terms
   with the sign on the numerator and positive denominator.
   Raises an error if d is 0."
  (if (= d 0)
    (error "make-rat: denominator cannot be zero")
    (let ((g (gcd n d)))
      (let ((reduced-num (quotient n g))
            (reduced-den (quotient (abs d) g)))
        ; Normalize sign: denominator always positive, sign on numerator
        (if (< d 0)
          (list (- reduced-num) reduced-den)
          (list reduced-num reduced-den))))))

(define (rat-num r)
  "Return the numerator of a rational in canonical form."
  (car r))

(define (rat-den r)
  "Return the denominator of a rational in canonical form.
   Always strictly positive."
  (cadr r))

(define (rat-add a b)
  "Return the sum of two rationals, in canonical form."
  (make-rat
    (+ (* (rat-num a) (rat-den b))
       (* (rat-num b) (rat-den a)))
    (* (rat-den a) (rat-den b))))

(define (rat-sub a b)
  "Return the difference of two rationals, in canonical form."
  (make-rat
    (- (* (rat-num a) (rat-den b))
       (* (rat-num b) (rat-den a)))
    (* (rat-den a) (rat-den b))))

(define (rat-mul a b)
  "Return the product of two rationals, in canonical form."
  (make-rat
    (* (rat-num a) (rat-num b))
    (* (rat-den a) (rat-den b))))

(define (rat-div a b)
  "Return the quotient of two rationals, in canonical form.
   Raises an error if b is zero (numerator zero)."
  (if (= (rat-num b) 0)
    (error "rat-div: cannot divide by zero")
    (make-rat
      (* (rat-num a) (rat-den b))
      (* (rat-den a) (rat-num b)))))

(define (rat-equal? a b)
  "Return true if two rationals represent the same value, false otherwise.
   Since both are in canonical form, simply compare their components."
  (and (= (rat-num a) (rat-num b))
       (= (rat-den a) (rat-den b))))

(define (rat-less? a b)
  "Return true if a is strictly less than b, false otherwise.
   Works correctly for negatives by cross-multiplication:
   a/c < b/d iff a*d < b*c (when c > 0 and d > 0)."
  (< (* (rat-num a) (rat-den b))
     (* (rat-num b) (rat-den a))))

(define (rat->string r)
  "Render a rational as a string.
   If denominator is 1, returns just the integer (e.g. '3', '-2', '0').
   Otherwise returns 'numerator/denominator' (e.g. '1/2', '-3/4')."
  (if (= (rat-den r) 1)
    (number->string (rat-num r))
    (string-append
      (number->string (rat-num r))
      "/"
      (number->string (rat-den r)))))

(define (rat->float r)
  "Return the floating-point value of the rational as a float.
   Computes numerator / denominator."
  (/ (rat-num r) (rat-den r)))

;;; Demo: compute some simple rational arithmetic and display results
(define r1 (make-rat 1 2))
(define r2 (make-rat 1 3))
(define r3 (rat-add r1 r2))

(displayln (string-append "1/2 + 1/3 = " (rat->string r3)))
(displayln (string-append "1/2 - 1/3 = " (rat->string (rat-sub r1 r2))))
(displayln (string-append "2/3 * 3/4 = " (rat->string (rat-mul (make-rat 2 3) (make-rat 3 4)))))
(displayln (string-append "(1/2) / (3/4) = " (rat->string (rat-div (make-rat 1 2) (make-rat 3 4)))))
