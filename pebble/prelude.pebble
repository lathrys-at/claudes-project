;;; Standard library for Pebble Lisp
;;; Loaded automatically into the global environment

; ===== MACROS =====

; when: (when test body...) - evaluate body only if test is truthy
(define-macro (when test . body)
  `(if ,test (begin ,@body) nil))

; unless: (unless test body...) - evaluate body only if test is falsy
(define-macro (unless test . body)
  `(if ,test nil (begin ,@body)))

; if-let: (if-let (VAR EXPR) THEN ELSE) or (if-let (VAR EXPR) THEN)
; Bind VAR to the result of EXPR (evaluated exactly once); if truthy, evaluate THEN with VAR in scope;
; otherwise evaluate ELSE (or return nil if no ELSE). Essential for safe chaining with optional values.
(define-macro (if-let binding then-form . else-forms)
  (let ((var (car binding))
        (expr (cadr binding))
        (expr-gensym (gensym)))
    `(let ((,expr-gensym ,expr))
       (let ((,var ,expr-gensym))
         (if ,var
           ,then-form
           ,(if (null? else-forms) nil (car else-forms)))))))

; when-let: (when-let (VAR EXPR) BODY...)
; Bind VAR to the result of EXPR (evaluated exactly once); if truthy, evaluate BODY forms in order
; with VAR in scope and return the value of the last one; otherwise return nil.
(define-macro (when-let binding . body)
  (let ((var (car binding))
        (expr (cadr binding))
        (expr-gensym (gensym)))
    `(let ((,expr-gensym ,expr))
       (let ((,var ,expr-gensym))
         (if ,var (begin ,@body) nil)))))

; and: variadic short-circuiting logical AND
(define-macro (and . args)
  (if (null? args)
    'true
    (if (null? (cdr args))
      (car args)
      (let ((first-gensym (gensym)))
        `(let ((,first-gensym ,(car args)))
           (if ,first-gensym (and ,@(cdr args)) ,first-gensym))))))

; or: variadic short-circuiting logical OR
(define-macro (or . args)
  (if (null? args)
    'false
    (if (null? (cdr args))
      (car args)
      (let ((first-gensym (gensym)))
        `(let ((,first-gensym ,(car args)))
           (if ,first-gensym ,first-gensym (or ,@(cdr args))))))))

; cond: (cond clause...) where each clause is (test body...)
(define-macro (cond . clauses)
  (if (null? clauses)
    nil
    (let ((clause (car clauses)))
      (if (and (pair? clause) (symbol? (car clause)) (= (symbol->string (car clause)) "else"))
        `(begin ,@(cdr clause))
        (if (null? (cdr clause))
          ; No body: return the test value (evaluate test exactly once)
          (let ((test-gensym (gensym)))
            `(let ((,test-gensym ,(car clause)))
               (if ,test-gensym ,test-gensym (cond ,@(cdr clauses)))))
          ; Has body: return the last body form
          `(if ,(car clause)
             (begin ,@(cdr clause))
             (cond ,@(cdr clauses))))))))

; let*: (let* (binding...) body...) - bindings are sequential/nested
(define-macro (let* bindings . body)
  (if (null? bindings)
    `(begin ,@body)
    `(let (,(car bindings))
       (let* ,(cdr bindings) ,@body))))

; case: (case key-expr clause...) where each clause is (datum-list body...) or (else body...)
; build-clauses is a local helper function that recursively builds the nested if-expression
(define (case-build-clauses clauses key-gensym)
  (if (null? clauses)
    nil
    (let ((clause (car clauses)))
      (if (and (pair? clause) (symbol? (car clause)) (= (symbol->string (car clause)) "else"))
        `(begin ,@(cdr clause))
        (if (null? (cdr clause))
          ; Clause has no body: match any datum in the list, return nil
          `(if (contains? (quote ,(car clause)) ,key-gensym)
             nil
             ,(case-build-clauses (cdr clauses) key-gensym))
          ; Clause has body: match any datum in the list, evaluate body
          `(if (contains? (quote ,(car clause)) ,key-gensym)
             (begin ,@(cdr clause))
             ,(case-build-clauses (cdr clauses) key-gensym)))))))

(define-macro case
  (lambda (key-expr . clauses)
    (let ((key-gensym (gensym)))
      `(let ((,key-gensym ,key-expr))
         ,(case-build-clauses clauses key-gensym)))))

; while: (while cond body...) - loop with tail-call optimization
(define-macro (while cond . body)
  (let ((loop-gensym (gensym)))
    `(let ,loop-gensym ()
       (if ,cond
         (begin ,@body (,loop-gensym))
         nil))))

; dotimes: (dotimes (var count-expr) body...) - loop from 0 to count-1 with tail-call optimization
(define-macro (dotimes binding . body)
  (let ((var (car binding))
        (count-expr (cadr binding))
        (count-gensym (gensym))
        (loop-gensym (gensym)))
    `(let ((,count-gensym ,count-expr))
       (let ,loop-gensym ((,var 0))
         (if (< ,var ,count-gensym)
           (begin ,@body (,loop-gensym (+ ,var 1)))
           nil)))))

; ===== ACCESSORS =====

; car/cdr combinations
(define (caar x) (car (car x)))
(define (cadr x) (car (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
(define (cddr x) (cdr (cdr x)))

; first/second/third/rest
(define (first lst) (car lst))
(define (second lst) (cadr lst))
(define (third lst) (caddr lst))
(define (rest lst) (cdr lst))

; ===== BASIC FUNCTIONS =====

; identity: returns its argument unchanged
(define (identity x) x)

; inc: increment by 1
(define (inc n) (+ n 1))

; dec: decrement by 1
(define (dec n) (- n 1))

; ===== NUMERIC PREDICATES =====

; zero?: test if number is 0
(define (zero? n) (= n 0))

; positive?: test if number > 0
(define (positive? n) (> n 0))

; negative?: test if number < 0
(define (negative? n) (< n 0))

; even?: test if number is divisible by 2
(define (even? n) (= (modulo n 2) 0))

; odd?: test if number is not divisible by 2
(define (odd? n) (not (even? n)))

; ===== BASE CONVERSION FUNCTIONS =====

; number->base: convert a non-negative integer to a string representation in a given base (2-16)
; (number->base n base) returns string representation using lowercase digits 0-9a-f
; Raises EvalError if n is negative/non-integer, or if base is not in 2..16
(define (number->base n base)
  ; Check that n is a non-negative integer
  (if (not (and (integer? n) (>= n 0)))
    (error "number->base: n must be a non-negative integer"))
  ; Check that base is an integer in range 2..16
  (if (not (and (integer? base) (>= base 2) (<= base 16)))
    (error "number->base: base must be an integer in 2..16"))
  ; Handle special case n = 0
  (if (= n 0)
    "0"
    (let ()
      ; Helper to convert number to list of digit values (in reverse order)
      (define (to-digits n base acc)
        (if (= n 0)
          acc
          (to-digits (quotient n base) base (cons (modulo n base) acc))))
      ; Convert digit values to characters using the digit string
      (define (digits-to-string digits)
        (if (null? digits)
          ""
          (string-append
            (char-at "0123456789abcdef" (car digits))
            (digits-to-string (cdr digits)))))
      (digits-to-string (to-digits n base nil)))))

; base->number: parse a string as a non-negative integer in a given base (2-16)
; (base->number s base) returns the integer value
; Raises EvalError if base is not in 2..16, string is empty, or contains invalid digits
(define (base->number s base)
  ; Check that base is an integer in range 2..16
  (if (not (and (integer? base) (>= base 2) (<= base 16)))
    (error "base->number: base must be an integer in 2..16"))
  ; Check that string is not empty
  (if (= (string-length s) 0)
    (error "base->number: string cannot be empty"))
  ; Helper to parse string left to right, accumulating value
  (define (parse-digits s base idx acc)
    (if (= idx (string-length s))
      acc
      (let ((c (substring s idx (+ idx 1))))
        (let ((digit-value (string-index "0123456789abcdef" c)))
          (if (= digit-value -1)
            (error (string-append "base->number: invalid character '" c "' for base " (number->string base)))
            (if (>= digit-value base)
              (error (string-append "base->number: digit '" c "' is too large for base " (number->string base)))
              (parse-digits s base (+ idx 1) (+ (* acc base) digit-value))))))))
  (parse-digits s base 0 0))

; number->binary: (number->binary n) = (number->base n 2)
(define (number->binary n)
  (number->base n 2))

; number->hex: (number->hex n) = (number->base n 16)
(define (number->hex n)
  (number->base n 16))

; binary->number: (binary->number s) = (base->number s 2)
(define (binary->number s)
  (base->number s 2))

; hex->number: (hex->number s) = (base->number s 16)
(define (hex->number s)
  (base->number s 16))

; ===== HIGHER-ORDER FUNCTIONS =====

; compose: (compose f g) returns a function that does f(g(x))
(define (compose f g)
  (lambda (x) (f (g x))))

; const: (const x) returns a function that always returns x
(define (const x)
  (lambda (y) x))

; partial: (partial f . fixed-args) returns a new function that, when called with
; additional arguments, calls f with fixed-args followed by those additional arguments
(define (partial f . fixed-args)
  (lambda args
    (apply f (append fixed-args args))))

; flip: (flip f) returns a two-argument function that swaps the arguments to f
(define (flip f)
  (lambda (a b)
    (f b a)))

; complement: (complement pred) returns a function that returns the boolean negation
; of pred applied to the same arguments (works for any arity)
(define (complement pred)
  (lambda args
    (not (apply pred args))))

; memoize: (memoize f) returns a new function g that caches results of f
; g invokes f AT MOST ONCE for each distinct argument list.
; The cache is stored in a mutable vector cell holding an immutable hash map.
; Uses the argument list as the cache key (lists are hashable in Pebble).
(define (memoize f)
  (let ((cache-cell (vector (make-hash))))
    (lambda args
      (let ((cache (vector-ref cache-cell 0)))
        (if (hash-has? cache args)
          (hash-ref cache args)
          (let ((result (apply f args)))
            (vector-set! cache-cell 0 (hash-set (vector-ref cache-cell 0) args result))
            result))))))

; ===== LIST FUNCTIONS =====

; last: returns the last element of a non-empty list
(define (last lst)
  (if (null? (cdr lst))
    (car lst)
    (last (cdr lst))))

; nth: returns the zero-indexed i-th element of lst
(define (nth lst i)
  (if (= i 0)
    (car lst)
    (nth (cdr lst) (- i 1))))

; range: returns a list of integers
; (range n) -> (0 1 ... n-1)
; (range a b) -> (a a+1 ... b-1)
; Uses a tail-recursive inner function
(define (range . args)
  (cond
    ((= (length args) 1)
     (let ((n (car args)))
       (define (range-helper i acc)
         (if (= i n)
           (reverse acc)
           (range-helper (+ i 1) (cons i acc))))
       (range-helper 0 nil)))
    ((= (length args) 2)
     (let ((a (car args)) (b (cadr args)))
       (define (range-helper i acc)
         (if (>= i b)
           (reverse acc)
           (range-helper (+ i 1) (cons i acc))))
       (range-helper a nil)))))

; take: returns the first n elements of lst
; Uses a tail-recursive helper with accumulator to avoid stack overflow
(define (take lst n)
  (define (take-helper lst n acc)
    (if (= n 0)
      (reverse acc)
      (if (null? lst)
        (reverse acc)
        (take-helper (cdr lst) (- n 1) (cons (car lst) acc)))))
  (take-helper lst n nil))

; drop: returns lst with the first n elements removed
(define (drop lst n)
  (if (= n 0)
    lst
    (if (null? lst)
      nil
      (drop (cdr lst) (- n 1)))))

; sum: sum of a list of numbers (empty list -> 0)
(define (sum lst)
  (foldl + 0 lst))

; product: product of a list of numbers (empty list -> 1)
(define (product lst)
  (foldl * 1 lst))

; reduce: fold over a non-empty list using the first element as accumulator
(define (reduce f lst)
  (if (null? lst)
    (error "reduce: empty list")
    (foldl f (car lst) (cdr lst))))

; map2: applies a two-argument function to corresponding elements of two lists
; Uses a tail-recursive helper with accumulator to avoid stack overflow
(define (map2 f a b)
  (define (map2-helper f a b acc)
    (if (null? a)
      (reverse acc)
      (if (null? b)
        (reverse acc)
        (map2-helper f (cdr a) (cdr b) (cons (f (car a) (car b)) acc)))))
  (map2-helper f a b nil))

; zip: pairs corresponding elements of two lists
(define (zip a b)
  (map2 list a b))

; flatten: flattens an arbitrarily-nested list structure
(define (flatten lst)
  (foldl
    (lambda (acc elem)
      (if (list? elem)
        (append acc (flatten elem))
        (append acc (list elem))))
    nil
    lst))

; take-while: returns the longest prefix of lst whose elements all satisfy pred
; Uses a tail-recursive helper with accumulator to avoid stack overflow
(define (take-while pred lst)
  (define (take-while-helper pred lst acc)
    (if (null? lst)
      (reverse acc)
      (if (pred (car lst))
        (take-while-helper pred (cdr lst) (cons (car lst) acc))
        (reverse acc))))
  (take-while-helper pred lst nil))

; drop-while: returns lst with the leading run of pred-satisfying elements removed
; Returns lst starting from the first element that does NOT satisfy pred
(define (drop-while pred lst)
  (if (null? lst)
    nil
    (if (pred (car lst))
      (drop-while pred (cdr lst))
      lst)))

; find: returns the first element of lst satisfying pred, or false if none does
(define (find pred lst)
  (if (null? lst)
    false
    (if (pred (car lst))
      (car lst)
      (find pred (cdr lst)))))

; any?: returns true iff at least one element of lst satisfies pred
; For the empty list, returns false
(define (any? pred lst)
  (if (null? lst)
    false
    (if (pred (car lst))
      true
      (any? pred (cdr lst)))))

; all?: returns true iff every element of lst satisfies pred
; For the empty list, returns true (vacuously)
(define (all? pred lst)
  (if (null? lst)
    true
    (if (pred (car lst))
      (all? pred (cdr lst))
      false)))

; count-if: returns the number of elements of lst that satisfy pred
; Uses foldl for stack-safety
(define (count-if pred lst)
  (foldl
    (lambda (acc elem)
      (if (pred elem)
        (+ acc 1)
        acc))
    0
    lst))

; partition: returns a two-element list (list yes no) where
; yes is the list of elements satisfying pred and no is the list of those that do not
; Each preserves the original relative order
; Uses a tail-recursive helper with two accumulators, then reverses each
(define (partition pred lst)
  (define (partition-helper pred lst yes-acc no-acc)
    (if (null? lst)
      (list (reverse yes-acc) (reverse no-acc))
      (if (pred (car lst))
        (partition-helper pred (cdr lst) (cons (car lst) yes-acc) no-acc)
        (partition-helper pred (cdr lst) yes-acc (cons (car lst) no-acc)))))
  (partition-helper pred lst nil nil))

; ===== STRING FUNCTIONS =====

; string-join: joins a list of strings with a separator
; Uses a tail-recursive helper with accumulator to avoid stack overflow
(define (string-join lst sep)
  (define (join-helper lst sep acc)
    (if (null? lst)
      acc
      (join-helper (cdr lst) sep (string-append acc sep (car lst)))))
  (if (null? lst)
    ""
    (if (null? (cdr lst))
      (car lst)
      (join-helper (cdr lst) sep (car lst)))))

; ===== SORTING FUNCTIONS =====

; Helper: integer division by 2 (tail recursive)
(define (div-by-2 n)
  (define (helper n acc)
    (if (< n 2)
      acc
      (helper (- n 2) (+ acc 1))))
  (helper n 0))

; Helper: split a list into two halves
; Returns a list of two lists: (list first-half second-half)
(define (split-list lst)
  (define (split-helper lst left-acc count)
    (if (= count 0)
      (list (reverse left-acc) lst)
      (if (null? lst)
        (list (reverse left-acc) nil)
        (split-helper (cdr lst) (cons (car lst) left-acc) (- count 1)))))
  (let ((len (length lst)))
    (if (<= len 1)
      (list lst nil)
      (split-helper lst nil (div-by-2 len)))))

; Helper: merge two sorted lists using a custom comparison function
; Uses tail recursion with accumulators to avoid stack overflow
; For stability: when elements are equal (neither less? nor reverse less?), prefer left
(define (merge-lists less? left right)
  (define (merge-helper left right acc)
    (if (null? left)
      (append (reverse acc) right)
      (if (null? right)
        (append (reverse acc) left)
        (if (less? (car left) (car right))
          (merge-helper (cdr left) right (cons (car left) acc))
          ; If not (less? (car left) (car right)), take from left only if right is not less
          ; This ensures stability: when equal, left comes first (is taken first)
          (if (less? (car right) (car left))
            (merge-helper left (cdr right) (cons (car right) acc))
            ; Elements are equal, take from left for stability
            (merge-helper (cdr left) right (cons (car left) acc)))))))
  (merge-helper left right nil))

; Helper: merge sort using a custom comparison function
; Divide-and-conquer recursion (logarithmic depth) on list size,
; but merge operations use tail recursion to avoid stack overflow on long lists
(define (merge-sort-helper less? lst)
  (let ((len (length lst)))
    (if (<= len 1)
      lst
      (let ((halves (split-list lst)))
        (let ((left-sorted (merge-sort-helper less? (car halves)))
              (right-sorted (merge-sort-helper less? (cadr halves))))
          (merge-lists less? left-sorted right-sorted))))))

; sort: returns a new list with elements sorted in ascending order using <
(define (sort lst)
  (merge-sort-helper < lst))

; sort-with: returns a new list sorted using a custom binary predicate
(define (sort-with less? lst)
  (merge-sort-helper less? lst))

; ===== ASSOCIATION LIST FUNCTIONS =====

; assoc: returns the first (key value) pair from alist where key equals the given key, or false
(define (assoc key alist)
  (if (null? alist)
    false
    (if (= (car (car alist)) key)
      (car alist)
      (assoc key (cdr alist)))))

; ===== LIST SEARCH FUNCTIONS =====

; contains?: returns true if x is an element of lst (using =), false otherwise
(define (contains? lst x)
  (if (null? lst)
    false
    (if (= (car lst) x)
      true
      (contains? (cdr lst) x))))

; index-of: returns the zero-based index of the first element equal to x, or -1 if not found
(define (index-of lst x)
  (define (index-helper lst x idx)
    (if (null? lst)
      -1
      (if (= (car lst) x)
        idx
        (index-helper (cdr lst) x (+ idx 1)))))
  (index-helper lst x 0))

; ===== LIST SET OPERATIONS =====
; All functions treat lists as sets and preserve order of first appearance with no duplicates

; unique: returns lst with duplicate elements removed, keeping first occurrence
; Uses tail-recursive helper with accumulator and reverse for stack-safety and efficiency
(define (unique lst)
  (define (unique-helper lst acc)
    (if (null? lst)
      (reverse acc)
      (let ((elem (car lst)))
        (if (contains? acc elem)
          (unique-helper (cdr lst) acc)
          (unique-helper (cdr lst) (cons elem acc))))))
  (unique-helper lst nil))

; Helper for union: build unique list from b excluding elements in a and already in acc
(define (union-helper-b lst a acc)
  (if (null? lst)
    (reverse acc)
    (let ((elem (car lst)))
      (if (or (contains? a elem) (contains? acc elem))
        (union-helper-b (cdr lst) a acc)
        (union-helper-b (cdr lst) a (cons elem acc))))))

; union: returns the set union of two lists
; Includes each distinct element from a or b, with a's elements first in their original order,
; followed by distinct elements from b that are not in a
(define (union a b)
  (let ((unique-a (unique a)))
    (append unique-a (union-helper-b b unique-a nil))))

; Helper for intersection
(define (intersection-helper lst b acc)
  (if (null? lst)
    (reverse acc)
    (let ((elem (car lst)))
      (if (and (contains? b elem) (not (contains? acc elem)))
        (intersection-helper (cdr lst) b (cons elem acc))
        (intersection-helper (cdr lst) b acc)))))

; intersection: returns the distinct elements that appear in both a and b
; Preserves the order they appear in a
(define (intersection a b)
  (intersection-helper a b nil))

; Helper for difference
(define (difference-helper lst b acc)
  (if (null? lst)
    (reverse acc)
    (let ((elem (car lst)))
      (if (and (not (contains? b elem)) (not (contains? acc elem)))
        (difference-helper (cdr lst) b (cons elem acc))
        (difference-helper (cdr lst) b acc)))))

; difference: returns the distinct elements of a that do not appear in b
; Preserves the order they appear in a
(define (difference a b)
  (difference-helper a b nil))

; ===== LIST AGGREGATE FUNCTIONS =====

; maximum: returns the largest element of a non-empty list
(define (maximum lst)
  (if (null? lst)
    (error "maximum: empty list")
    (reduce max lst)))

; minimum: returns the smallest element of a non-empty list
(define (minimum lst)
  (if (null? lst)
    (error "minimum: empty list")
    (reduce min lst)))

; ===== STATISTICS FUNCTIONS =====

; mean: returns the arithmetic mean of a non-empty list of numbers
; (mean lst) = (sum lst) / (length lst)
; Raises EvalError on the empty list
(define (mean lst)
  (if (null? lst)
    (error "mean: empty list")
    (/ (sum lst) (length lst))))

; median: returns the median of a non-empty list of numbers
; Sorts the list; if odd length, returns the middle element;
; if even length, returns the average of the two middle elements
; Raises EvalError on the empty list
(define (median lst)
  (if (null? lst)
    (error "median: empty list")
    (let ((sorted (sort lst)))
      (let ((len (length sorted)))
        (if (= (modulo len 2) 1)
          ; Odd length: return middle element
          (nth sorted (quotient len 2))
          ; Even length: return average of two middle elements
          (let ((mid-idx (quotient len 2)))
            (/ (+ (nth sorted (- mid-idx 1)) (nth sorted mid-idx)) 2)))))))

; variance: returns the population variance of a non-empty list of numbers
; variance = (sum of (xi - mean)^2) / length
; Raises EvalError on the empty list
(define (variance lst)
  (if (null? lst)
    (error "variance: empty list")
    (let ((m (mean lst)))
      (let ((squared-diffs (map (lambda (x) (* (- x m) (- x m))) lst)))
        (/ (sum squared-diffs) (length lst))))))

; stddev: returns the population standard deviation of a non-empty list of numbers
; stddev = sqrt(variance)
; Raises EvalError on the empty list
(define (stddev lst)
  (if (null? lst)
    (error "stddev: empty list")
    (sqrt (variance lst))))

; ===== LIST GENERATION FUNCTIONS =====

; repeat: returns a list containing x repeated n times
(define (repeat x n)
  (if (= n 0)
    nil
    (cons x (repeat x (- n 1)))))

; iterate: (iterate f x n) returns a list of n elements: x, (f x), (f (f x)), ..., (f^(n-1) x)
; Stack-safe implementation using tail recursion with accumulator
(define (iterate f x n)
  (define (iterate-helper f current count acc)
    (if (= count 0)
      (reverse acc)
      (iterate-helper f (f current) (- count 1) (cons current acc))))
  (iterate-helper f x n nil))

; range-step: (range-step start stop step) returns an arithmetic sequence
; If step is positive, include values while value < stop
; If step is negative, include values while value > stop
; step must be nonzero (raises EvalError if step is 0)
; Stack-safe implementation using tail recursion with accumulator
(define (range-step start stop step)
  (if (= step 0)
    (error "range-step: step must be nonzero")
    (let ()
      (define (range-step-helper current acc)
        (if (if (> step 0)
              (>= current stop)
              (<= current stop))
          (reverse acc)
          (range-step-helper (+ current step) (cons current acc))))
      (range-step-helper start nil))))

; ===== STRING MANIPULATION FUNCTIONS =====

; string-split: splits string s into a list of substrings separated by sep
(define (string-split s sep)
  (if (= (string-length sep) 0)
    (error "string-split: separator cannot be empty")
    (let ()
      (define (split-helper s sep parts current-part)
        (if (= (string-length s) 0)
          (reverse (cons current-part parts))
          (let ((sep-len (string-length sep)))
            (if (>= (string-length s) sep-len)
              (if (= (substring s 0 sep-len) sep)
                (split-helper
                  (substring s sep-len (string-length s))
                  sep
                  (cons current-part parts)
                  "")
                (split-helper
                  (substring s 1 (string-length s))
                  sep
                  parts
                  (string-append current-part (substring s 0 1))))
              (split-helper
                (substring s 1 (string-length s))
                sep
                parts
                (string-append current-part (substring s 0 1)))))))
      (split-helper s sep nil ""))))

; string-reverse: (string-reverse s) returns s with its characters in reverse order
(define (string-reverse s)
  (list->string (reverse (string->list s))))

; words: (words s) splits the string s on runs of whitespace into a list of non-empty words
; Leading/trailing/repeated whitespace produces NO empty strings in the result.
; A string with no words (empty or all whitespace) yields nil.
(define (words s)
  (define (skip-whitespace s)
    (if (= (string-length s) 0)
      ""
      (if (char-whitespace? (substring s 0 1))
        (skip-whitespace (substring s 1 (string-length s)))
        s)))
  (define (take-word s)
    (if (= (string-length s) 0)
      ""
      (if (char-whitespace? (substring s 0 1))
        ""
        (string-append
          (substring s 0 1)
          (take-word (substring s 1 (string-length s)))))))
  (define (words-helper s acc)
    (let ((trimmed (skip-whitespace s)))
      (if (= (string-length trimmed) 0)
        (if (null? acc) nil (reverse acc))
        (let ((word (take-word trimmed)))
          (let ((rest (substring trimmed (string-length word) (string-length trimmed))))
            (words-helper rest (cons word acc)))))))
  (words-helper s nil))

; unwords: (unwords lst) joins a list of strings into a single string separated by a single space
; The empty list yields the empty string "".
(define (unwords lst)
  (string-join lst " "))

; lines: (lines s) splits the string s on newline characters into a list of line strings
; KEEPING empty segments (i.e. equivalent to splitting on "\n").
(define (lines s)
  (string-split s "\n"))

; unlines: (unlines lst) joins a list of strings with newline characters between them
; Equivalent to joining with "\n". The empty list yields "".
(define (unlines lst)
  (string-join lst "\n"))

; palindrome?: (palindrome? s) returns true iff string s reads the same forwards and backwards
; Case-sensitive; all characters count. Empty string and single-character strings are palindromes.
(define (palindrome? s)
  (= s (string-reverse s)))

; anagram?: (anagram? a b) returns true iff strings a and b are anagrams of each other
; Case-sensitive; all characters count.
; Two strings are anagrams iff they contain exactly the same characters with the same multiplicities.
; Implementation: sort the characters of each string and compare
(define (anagram? a b)
  (= (sort (string->list a)) (sort (string->list b))))

; capitalize: (capitalize s) returns s with its FIRST character uppercased and the rest UNCHANGED
(define (capitalize s)
  (if (= (string-length s) 0)
    ""
    (string-append
      (char-upcase (substring s 0 1))
      (substring s 1 (string-length s)))))

; string-pad-left: (string-pad-left s width fill) pads s on the LEFT with fill (1-char string) to width
; If string length is >= width, returns s unchanged
; Raises EvalError if fill is not a string of length exactly 1
(define (string-pad-left s width fill)
  (if (not (= (string-length fill) 1))
    (error "string-pad-left: fill must be a string of length 1")
    (let ((s-len (string-length s))
          (pad-count (- width (string-length s))))
      (if (<= pad-count 0)
        s
        (string-append (string-repeat fill pad-count) s)))))

; string-pad-right: (string-pad-right s width fill) pads s on the RIGHT with fill (1-char string) to width
; If string length is >= width, returns s unchanged
; Raises EvalError if fill is not a string of length exactly 1
(define (string-pad-right s width fill)
  (if (not (= (string-length fill) 1))
    (error "string-pad-right: fill must be a string of length 1")
    (let ((s-len (string-length s))
          (pad-count (- width (string-length s))))
      (if (<= pad-count 0)
        s
        (string-append s (string-repeat fill pad-count))))))

; ===== IO FUNCTIONS =====

; displayln: displays value followed by newline, returns nil
(define (displayln x)
  (display x)
  (newline))

; ===== HASH MAP FUNCTIONS =====

; hash-update: (hash-update m k f default) returns a new hash map where key k is mapped to (f current)
; where current is the value m has for k, or default if k is absent.
; The input map m is unchanged.
(define (hash-update m k f default)
  (let ((current (hash-ref m k default)))
    (hash-set m k (f current))))

; hash-merge: (hash-merge m1 m2) returns a new hash map containing all entries from m1 and m2,
; with values from m2 winning for any key present in both.
; Neither input is modified.
(define (hash-merge m1 m2)
  (foldl
    (lambda (acc pair)
      (hash-set acc (car pair) (cadr pair)))
    m1
    (hash->list m2)))

; hash-map-values: (hash-map-values f m) returns a new hash map with the same keys as m,
; but each value v is replaced by (f v). The input map m is unchanged.
(define (hash-map-values f m)
  (foldl
    (lambda (acc pair)
      (let ((k (car pair))
            (v (cadr pair)))
        (hash-set acc k (f v))))
    (make-hash)
    (hash->list m)))

; hash-filter: (hash-filter pred m) returns a new hash map containing only those entries (k v)
; of m for which (pred k v) is truthy. The input map m is unchanged.
(define (hash-filter pred m)
  (foldl
    (lambda (acc pair)
      (let ((k (car pair))
            (v (cadr pair)))
        (if (pred k v)
          (hash-set acc k v)
          acc)))
    (make-hash)
    (hash->list m)))

; frequencies: (frequencies lst) returns a hash map mapping each distinct element of lst
; to the number of times it occurs. (frequencies nil) is an empty hash map.
(define (frequencies lst)
  (foldl
    (lambda (acc elem)
      (hash-update acc elem inc 0))
    (make-hash)
    lst))

; group-by: (group-by f lst) returns a hash map mapping each distinct key (f x)
; to the list of elements x of lst that produced that key, with each group's
; elements in their original relative order. (group-by f nil) is an empty hash map.
(define (group-by f lst)
  (foldl
    (lambda (acc elem)
      (let ((key (f elem)))
        (hash-update acc key (lambda (group) (append group (list elem))) nil)))
    (make-hash)
    lst))

; ===== PATTERN MATCHING =====

; match: pattern-matching macro that supports literal, variable, wildcard, list, and tail patterns
; Full recursive pattern matching with proper handling of all pattern types
(define-macro match
  (lambda (scrutinee . clauses)
    (let ((val-var (gensym)))
      `(let ((,val-var ,scrutinee))
         ,(match-gen-code clauses val-var)))))

; Generate code for clause matching - returns code as a list structure
(define (match-gen-code clauses val-var)
  (if (null? clauses)
    (list (quote error) "match: no matching clause")
    (let* ((clause (car clauses))
           (pat (car clause))
           (body (cdr clause))
           (rest-code (match-gen-code (cdr clauses) val-var))
           (pat-check (match-gen-check pat val-var))
           (pat-bindings (match-gen-bindings pat val-var)))
      (if (null? pat-bindings)
        ; No bindings: just (if check (begin body) rest-code)
        (list (quote if) pat-check (cons (quote begin) body) rest-code)
        ; With bindings: (if check (let bindings (begin body)) rest-code)
        (list (quote if) pat-check (list (quote let) pat-bindings (cons (quote begin) body)) rest-code)))))

; Detect if a pattern is a tail pattern: (P1 ... Pn . REST) where REST is a symbol
; Returns (list fixed-patterns rest-var) or false if not a tail pattern
(define (match-detect-tail-pattern pat)
  (if (or (not (pair? pat)) (null? pat))
    false
    (let ((len (length pat)))
      (if (and (> len 1) (symbol? (nth pat (- len 2))) (= (symbol->string (nth pat (- len 2))) "."))
        (let ((fixed-pats (take pat (- len 2)))
              (rest-var (nth pat (- len 1))))
          (if (symbol? rest-var)
            (list fixed-pats rest-var)
            false))
        false))))

; Generate a check expression for a pattern
; A pattern matches a value as follows (recursively):
; - _ : matches any value
; - (quote SYM) : matches iff value = symbol SYM
; - literal (number/string/bool) : matches iff value = literal
; - symbol : matches any value (binding)
; - nil : matches iff value is empty list
; - (P1 P2 ... Pn) : matches iff value is list of exactly length n AND each element matches recursively
; - (P1 ... Pn . REST) : matches iff value is list of length >= n AND first n elements match recursively
(define (match-gen-check pat val-var)
  (cond
    ; Wildcard: always matches
    ((and (symbol? pat) (= (symbol->string pat) "_"))
     (quote true))
    ; nil pattern: check null?
    ((null? pat)
     (list (quote null?) val-var))
    ; Literal patterns (number, string, boolean): check equality
    ((or (number? pat) (string? pat) (boolean? pat))
     (list (quote =) val-var (list (quote quote) pat)))
    ; Symbol variable (not wildcard, not quoted-form): always matches (binding occurs in gen-bindings)
    ((symbol? pat)
     (quote true))
    ; List/pair pattern: could be quoted-symbol, fixed-list, or tail pattern
    ((pair? pat)
     (let ((tail-info (match-detect-tail-pattern pat)))
       (if tail-info
         ; Tail pattern: (P1 ... Pn . REST)
         ; Check: value is list AND length >= n AND all fixed sub-patterns match
         (let ((fixed-pats (car tail-info))
               (fixed-count (length (car tail-info))))
           (match-gen-check-list-tail pat val-var fixed-pats fixed-count))
         ; Not a tail pattern; could be quoted-symbol or fixed-list
         (if (and (= (length pat) 2) (symbol? (car pat)) (= (symbol->string (car pat)) "quote") (symbol? (cadr pat)))
           ; Quoted-symbol pattern: (quote SYM)
           ; Check: value = the symbol SYM
           (list (quote =) val-var (list (quote quote) (cadr pat)))
           ; Fixed-list pattern: (P1 P2 ... Pn)
           ; Check: value is list AND length = n AND all sub-patterns match
           (match-gen-check-list-fixed pat val-var)))))
    (else (quote false))))

; Check for a fixed list pattern: value must be list of exactly length n,
; and all sub-patterns must recursively match their values
(define (match-gen-check-list-fixed pat val-var)
  (let ((len (length pat))
        (checks (match-gen-list-checks pat val-var 0)))
    (match-conjoin
      (list (list (quote list?) val-var)
            (list (quote =) (list (quote length) val-var) len))
      checks)))

; Check for a tail pattern: value must be list of at least length n,
; and all fixed sub-patterns must recursively match
(define (match-gen-check-list-tail pat val-var fixed-pats fixed-count)
  (let ((checks (match-gen-list-checks fixed-pats val-var 0)))
    (match-conjoin
      (list (list (quote list?) val-var)
            (list (quote >=) (list (quote length) val-var) fixed-count))
      checks)))

; Generate recursive checks for each element of a list pattern
(define (match-gen-list-checks pats val-var index)
  (if (null? pats)
    nil
    (let ((pat (car pats))
          (elem-check (match-gen-elem-check val-var index)))
      (cons
        ; Check: (match-elem-pattern pat (nth val-var index))
        (match-gen-check pat elem-check)
        (match-gen-list-checks (cdr pats) val-var (+ index 1))))))

; Generate code to access the i-th element: (nth val-var i)
(define (match-gen-elem-check val-var index)
  (list (quote nth) val-var index))

; Build a conjunction of checks (and-expression)
; If no checks, returns true; if one check, returns it; otherwise (and check1 check2 ...)
(define (match-conjoin base-checks elem-checks)
  (let ((all-checks (append base-checks elem-checks)))
    (cond
      ((null? all-checks) (quote true))
      ((null? (cdr all-checks)) (car all-checks))
      (else (cons (quote and) all-checks)))))

; Generate bindings for a pattern
; Returns list of (var value-expr) pairs to bind all pattern variables
(define (match-gen-bindings pat val-var)
  (cond
    ; Wildcard: no binding
    ((and (symbol? pat) (= (symbol->string pat) "_"))
     nil)
    ; Symbol (not wildcard): bind it to the value
    ((symbol? pat)
     (list (list pat val-var)))
    ; nil: no binding
    ((null? pat)
     nil)
    ; Literals (number, string, bool): no binding
    ((or (number? pat) (string? pat) (boolean? pat))
     nil)
    ; Quoted-symbol pattern (quote SYM): no binding
    ((and (pair? pat) (= (length pat) 2) (symbol? (car pat)) (= (symbol->string (car pat)) "quote"))
     nil)
    ; List pattern (could be fixed or tail)
    ((pair? pat)
     (let ((tail-info (match-detect-tail-pattern pat)))
       (if tail-info
         ; Tail pattern: collect bindings from fixed patterns + bind rest variable
         (let ((fixed-pats (car tail-info))
               (rest-var (cadr tail-info))
               (fixed-count (length (car tail-info))))
           (append
             (match-gen-list-bindings fixed-pats val-var 0)
             (list (list rest-var (list (quote drop) val-var fixed-count)))))
         ; Fixed list pattern: collect bindings from all element patterns recursively
         (match-gen-list-bindings pat val-var 0))))
    (else nil)))

; Generate bindings for list pattern elements recursively
; Each element pattern is matched against (nth val-var index)
(define (match-gen-list-bindings pats val-var index)
  (if (null? pats)
    nil
    (let ((pat (car pats))
          (elem-access (list (quote nth) val-var index)))
      (append
        (match-gen-bindings pat elem-access)
        (match-gen-list-bindings (cdr pats) val-var (+ index 1))))))

; ===== VECTOR FUNCTIONS =====

; vector-map: (vector-map f v) returns a NEW vector where each element i is (f (vector-ref v i))
; The original vector v is NOT modified.
(define (vector-map f v)
  (let ((len (vector-length v)))
    (let ((result (make-vector len)))
      (dotimes (i len)
        (vector-set! result i (f (vector-ref v i))))
      result)))

; vector-for-each: (vector-for-each f v) applies (f element) to each element in order for side effects
; Returns nil. For an empty vector, no calls are made.
(define (vector-for-each f v)
  (let ((len (vector-length v)))
    (dotimes (i len)
      (f (vector-ref v i)))
    nil))

; vector-copy: (vector-copy v) returns a NEW vector with the same elements as v
; The copy is independent: mutating the copy does not affect the original, and vice versa.
(define (vector-copy v)
  (let ((len (vector-length v)))
    (let ((result (make-vector len)))
      (dotimes (i len)
        (vector-set! result i (vector-ref v i)))
      result)))

; vector-fill!: (vector-fill! v x) sets EVERY element of v to x IN PLACE
; The vector v is mutated; all references to v will see this change.
; Returns nil.
(define (vector-fill! v x)
  (let ((len (vector-length v)))
    (dotimes (i len)
      (vector-set! v i x))
    nil))

; ===== RECORD TYPE DEFINITIONS =====

; define-record: (define-record NAME (FIELD1 FIELD2 ...))
; Expands to multiple definitions:
; - (make-NAME v1 v2 ...) - constructor
; - (NAME? x) - type predicate
; - (NAME-FIELD r) - accessor for each field (read-only)
; - (set-NAME-FIELD! r v) - mutator for each field (mutable, returns nil)
; The implementation uses a mutable vector with a unique gensym as a type tag to make records unforgeable.
; Records are represented as: #[type-tag field1 field2 ...]
(define-macro (define-record name fields)
  (let ((type-tag (gensym "record-type")))
    (let ((make-name (string->symbol (string-append "make-" (symbol->string name))))
          (predicate-name (string->symbol (string-append (symbol->string name) "?")))
          (field-count (length fields)))
      (let ((field-indices (range (length fields))))
        (let ((accessor-defs
                (map2
                  (lambda (field idx)
                    (let ((accessor-name (string->symbol (string-append (symbol->string name) "-" (symbol->string field)))))
                      `(define (,accessor-name r)
                         (if (and (vector? r) (> (vector-length r) 0) (symbol? (vector-ref r 0)) (= (vector-ref r 0) (quote ,type-tag)))
                           (vector-ref r ,(+ idx 1))
                           (error (string-append ,(symbol->string accessor-name) " called on non-" ,(symbol->string name) " value"))))))
                  fields
                  field-indices)))
          (let ((mutator-defs
                  (map2
                    (lambda (field idx)
                      (let ((mutator-name (string->symbol (string-append "set-" (symbol->string name) "-" (symbol->string field) "!"))))
                        `(define (,mutator-name r v)
                           (if (and (vector? r) (> (vector-length r) 0) (symbol? (vector-ref r 0)) (= (vector-ref r 0) (quote ,type-tag)))
                             (begin (vector-set! r ,(+ idx 1) v) nil)
                             (error (string-append ,(symbol->string mutator-name) " called on non-" ,(symbol->string name) " value"))))))
                    fields
                    field-indices)))
            `(begin
               (define (,make-name . args)
                 (if (= (length args) ,field-count)
                   (let ((vec (make-vector ,(+ field-count 1))))
                     (vector-set! vec 0 (quote ,type-tag))
                     ,@(let ()
                         (define (make-set-stmts remaining-args idx)
                           (if (null? remaining-args)
                             nil
                             (cons
                               `(vector-set! vec ,idx (nth args ,(- idx 1)))
                               (make-set-stmts (cdr remaining-args) (+ idx 1)))))
                         (make-set-stmts fields 1))
                     vec)
                   (error (string-append "make-" ,(symbol->string name) " expects " ,(number->string field-count) " arguments"))))
               (define (,predicate-name x)
                 (and (vector? x) (= (vector-length x) ,(+ field-count 1)) (symbol? (vector-ref x 0)) (= (vector-ref x 0) (quote ,type-tag))))
               ,@accessor-defs
               ,@mutator-defs
               (quote ,name))))))))

; ===== LAZY EVALUATION (PROMISES) =====

; Create a unique tag for all promises (so promise? can recognize them)
(define promise-tag (gensym "promise"))

; delay: (delay EXPR) - macro that defers evaluation of EXPR
; Returns a promise (a mutable vector) that captures EXPR as a zero-argument lambda
; The vector structure: #[promise-tag false thunk-or-value]
; - Element 0: promise-tag (unique symbol)
; - Element 1: forced? flag (false initially, true after first force)
; - Element 2: thunk (initially) or cached-value (after first force)
(define-macro (delay expr)
  `(let ((promise-vec (make-vector 3)))
     (vector-set! promise-vec 0 promise-tag)
     (vector-set! promise-vec 1 false)
     (vector-set! promise-vec 2 (lambda () ,expr))
     promise-vec))

; force: (force P) - force a promise or return non-promises unchanged
; If P is a promise:
;   - If it has never been forced: evaluate the thunk, cache the result, mark as forced
;   - If already forced: return the cached value (thunk is not re-evaluated)
; If P is not a promise: return P unchanged
(define (force p)
  (if (and (vector? p) (= (vector-length p) 3) (= (vector-ref p 0) promise-tag))
    ; p is a promise
    (if (vector-ref p 1)
      ; Already forced: return cached value
      (vector-ref p 2)
      ; Not yet forced: evaluate thunk, cache result, mark as forced
      (let ((result ((vector-ref p 2))))
        (vector-set! p 2 result)
        (vector-set! p 1 true)
        result))
    ; p is not a promise, return as-is
    p))

; promise?: (promise? x) - test if x is a promise created by delay
; Returns true iff x is a promise (vector with the unique promise-tag), false otherwise
; Rejects ordinary vectors and lists that might resemble the internal structure
(define (promise? x)
  (and (vector? x) (= (vector-length x) 3) (= (vector-ref x 0) promise-tag)))

; ===== LAZY STREAMS =====
; A lazy stream is either nil (empty) or a two-element list (list HEAD (delay REST))
; where HEAD is the first element and REST is a promise wrapping the rest of the stream.

; stream-cons: MACRO that creates a stream with HEAD (evaluated now) and TAIL (delayed)
; Returns (list HEAD (delay TAIL))
; MUST be a macro so TAIL is not evaluated until stream-cdr forces it
(define-macro (stream-cons head tail)
  `(list ,head (delay ,tail)))

; stream-car: returns the head (first element) of a stream
; Assumes s is a non-empty stream (list HEAD promise)
(define (stream-car s)
  (car s))

; stream-cdr: returns the rest of the stream by forcing the delayed tail
; Takes a non-empty stream and returns the next stream
(define (stream-cdr s)
  (force (cadr s)))

; stream-null?: returns true iff s is the empty stream (the empty list)
(define (stream-null? s)
  (null? s))

; stream-take: returns an ordinary Pebble list of the first n elements of stream s
; Terminates when n reaches 0 or when stream becomes empty
; (stream-take s 0) returns the empty list
(define (stream-take s n)
  (if (= n 0)
    nil
    (if (null? s)
      nil
      (cons (stream-car s) (stream-take (stream-cdr s) (- n 1))))))

; stream-ref: returns the i-th element (0-indexed) of the stream
; Advances through the stream i times to reach the desired element
(define (stream-ref s i)
  (if (= i 0)
    (stream-car s)
    (stream-ref (stream-cdr s) (- i 1))))

; stream-map: returns a new stream lazily applying f to each element
; Does not apply f until elements are accessed via stream-cdr
(define (stream-map f s)
  (if (null? s)
    nil
    (stream-cons (f (stream-car s)) (stream-map f (stream-cdr s)))))

; stream-filter: returns a stream of the elements satisfying pred (lazily)
; Skips elements that do not satisfy pred
(define (stream-filter pred s)
  (if (null? s)
    nil
    (let ((head (stream-car s))
          (tail (stream-cdr s)))
      (if (pred head)
        (stream-cons head (stream-filter pred tail))
        (stream-filter pred tail)))))

; stream-zip-with: returns a stream whose i-th element is (f a_i b_i)
; for the i-th elements of s1 and s2
; STOPS when EITHER stream is empty (takes the shorter length)
(define (stream-zip-with f s1 s2)
  (if (or (null? s1) (null? s2))
    nil
    (stream-cons (f (stream-car s1) (stream-car s2))
                 (stream-zip-with f (stream-cdr s1) (stream-cdr s2)))))

; integers-from: returns the INFINITE stream n, n+1, n+2, ...
; Works because the tail is delayed: the recursive call is inside the delay,
; so the stream builds lazily without infinite recursion
(define (integers-from n)
  (stream-cons n (integers-from (+ n 1))))

; ===== ROMAN NUMERAL CONVERSION =====

; int->roman: (int->roman n) returns the Roman numeral string for integer n (1 <= n <= 3999)
; Uses standard subtractive notation
; Raises EvalError if n is not an integer or is outside 1..3999
(define (int->roman n)
  ; Validate input
  (if (not (integer? n))
    (error "int->roman: n must be an integer"))
  (if (or (< n 1) (> n 3999))
    (error "int->roman: n must be in range 1..3999"))
  ; Value-symbol pairs in descending order
  (let ((values (list 1000 900 500 400 100 90 50 40 10 9 5 4 1))
        (symbols (list "M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I")))
    (define (convert-helper n values symbols acc)
      (if (null? values)
        acc
        (let ((val (car values))
              (sym (car symbols)))
          (if (>= n val)
            (convert-helper (- n val) values symbols (string-append acc sym))
            (convert-helper n (cdr values) (cdr symbols) acc)))))
    (convert-helper n values symbols "")))

; roman->int: (roman->int s) returns the integer value of a Roman numeral string s
; Scans left to right: each letter's value is added, EXCEPT when a letter's value is
; less than the value of the letter immediately after it, in which case it is subtracted
; Letter values: I=1, V=5, X=10, L=50, C=100, D=500, M=1000
(define (roman->int s)
  (define (char-value c)
    (cond
      ((= c "I") 1)
      ((= c "V") 5)
      ((= c "X") 10)
      ((= c "L") 50)
      ((= c "C") 100)
      ((= c "D") 500)
      ((= c "M") 1000)
      (else (error (string-append "roman->int: invalid character '" c "'")))))
  (define (sum-helper s idx acc)
    (if (>= idx (string-length s))
      acc
      (let ((current-char (substring s idx (+ idx 1)))
            (current-val (char-value (substring s idx (+ idx 1)))))
        (if (< idx (- (string-length s) 1))
          (let ((next-char (substring s (+ idx 1) (+ idx 2)))
                (next-val (char-value (substring s (+ idx 1) (+ idx 2)))))
            (if (< current-val next-val)
              ; Current value is less than next: subtract it
              (sum-helper s (+ idx 1) (- acc current-val))
              ; Current value is >= next: add it
              (sum-helper s (+ idx 1) (+ acc current-val))))
          ; Last character: always add
          (+ acc current-val)))))
  (sum-helper s 0 0))

; chunk: (chunk lst n) splits lst into consecutive sublists of length n
; Returns a list of chunks, where each chunk has exactly n elements except possibly the last.
; The last chunk may be shorter if length is not a multiple of n.
; Empty list yields empty list.
; Stack-safe implementation using tail recursion with accumulator.
(define (chunk lst n)
  (if (null? lst)
    nil
    (let ((first-chunk (take lst n))
          (rest (drop lst n)))
      (cons first-chunk (if (null? rest)
                            nil
                            (chunk rest n))))))

; interleave: (interleave a b) returns a list alternating elements from a and b
; Stops when either list runs out.
; Stack-safe implementation using tail recursion with accumulator.
(define (interleave a b)
  (define (interleave-helper a b acc)
    (if (or (null? a) (null? b))
      (reverse acc)
      (interleave-helper (cdr a) (cdr b) (cons (car b) (cons (car a) acc)))))
  (interleave-helper a b nil))

; enumerate: (enumerate lst) returns a list of (index element) pairs
; Each element is paired with its zero-based index.
; Stack-safe implementation using tail recursion with accumulator.
(define (enumerate lst)
  (define (enumerate-helper lst idx acc)
    (if (null? lst)
      (reverse acc)
      (enumerate-helper (cdr lst) (+ idx 1) (cons (list idx (car lst)) acc))))
  (enumerate-helper lst 0 nil))

; ===== RUN-LENGTH ENCODING =====

; rle-encode: (rle-encode lst) returns the run-length encoding of lst
; Returns a list of two-element lists (element count), where each maximal run of
; consecutive equal elements (compared with =) becomes one (element count) pair, in order.
; Stack-safe implementation using tail recursion with accumulator.
(define (rle-encode lst)
  (define (encode-helper lst current-elem current-count acc)
    (if (null? lst)
      ; End of list: emit the current run if any, then reverse accumulator
      (if (= current-count 0)
        (reverse acc)
        (reverse (cons (list current-elem current-count) acc)))
      ; Process the next element
      (let ((next-elem (car lst)))
        (if (= next-elem current-elem)
          ; Same as current: increment count
          (encode-helper (cdr lst) current-elem (+ current-count 1) acc)
          ; Different from current: emit the current run (if any) and start a new run
          (if (= current-count 0)
            ; First element
            (encode-helper (cdr lst) next-elem 1 acc)
            ; Not first: emit current run and start new
            (encode-helper (cdr lst) next-elem 1 (cons (list current-elem current-count) acc)))))))
  (if (null? lst)
    nil
    (encode-helper (cdr lst) (car lst) 1 nil)))

; rle-decode: (rle-decode encoded) returns the original list from a run-length encoding
; For each (element count) pair, produces count copies of element, concatenated in order.
; Uses foldl to accumulate results and append runs.
(define (rle-decode encoded)
  (foldl
    (lambda (acc pair)
      (let ((elem (car pair))
            (count (cadr pair)))
        (append acc (repeat elem count))))
    nil
    encoded))

; ===== BINARY SEARCH =====

; binary-search: (binary-search vec target) performs binary search over the ASCENDING-SORTED vector vec
; for target, returning the 0-based INDEX where target is found, or -1 if target is not present.
; Uses a tail-recursive named let loop for stack-safety.
; Assumes vec is sorted in ascending order.
(define (binary-search vec target)
  (let ((len (vector-length vec)))
    (if (= len 0)
      -1
      (let loop ((lo 0) (hi (- len 1)))
        (if (> lo hi)
          -1
          (let ((mid (quotient (+ lo hi) 2)))
            (let ((mid-val (vector-ref vec mid)))
              (if (= mid-val target)
                mid
                (if (< mid-val target)
                  (loop (+ mid 1) hi)
                  (loop lo (- mid 1)))))))))))

; ===== COMBINATORICS FUNCTIONS =====

; factorial: (factorial n) returns n! for a non-negative integer n
; (factorial 0) is 1. Raises EvalError if n is not an integer or is negative.
; Implemented tail-recursively with accumulator to handle large n.
(define (factorial n)
  (if (not (integer? n))
    (error "factorial: n must be an integer"))
  (if (< n 0)
    (error "factorial: n must be non-negative"))
  (define (factorial-helper n acc)
    (if (= n 0)
      acc
      (factorial-helper (- n 1) (* acc n))))
  (factorial-helper n 1))

; permutations-count: (permutations-count n k) returns the number of k-permutations of n
; Defined as n! / (n-k)!. Requires non-negative integers n and k.
; If k > n, returns 0. (permutations-count n 0) is 1.
; Uses exact integer arithmetic.
(define (permutations-count n k)
  (if (not (integer? n))
    (error "permutations-count: n must be an integer"))
  (if (not (integer? k))
    (error "permutations-count: k must be an integer"))
  (if (< n 0)
    (error "permutations-count: n must be non-negative"))
  (if (< k 0)
    (error "permutations-count: k must be non-negative"))
  (if (> k n)
    0
    (quotient (factorial n) (factorial (- n k)))))

; combinations-count: (combinations-count n k) returns the binomial coefficient "n choose k"
; Defined as n! / (k! * (n-k)!). Requires non-negative integers n and k.
; If k > n, returns 0. (combinations-count n 0) and (combinations-count n n) are 1.
; Uses exact integer arithmetic.
(define (combinations-count n k)
  (if (not (integer? n))
    (error "combinations-count: n must be an integer"))
  (if (not (integer? k))
    (error "combinations-count: k must be an integer"))
  (if (< n 0)
    (error "combinations-count: n must be non-negative"))
  (if (< k 0)
    (error "combinations-count: k must be non-negative"))
  (if (> k n)
    0
    (quotient (factorial n) (* (factorial k) (factorial (- n k))))))

; ===== NUMBER THEORY FUNCTIONS =====

; prime?: (prime? n) returns true iff n is a prime number
; A number is prime iff it is >= 2 and has no divisors d with 2 <= d and d*d <= n
; Returns false for all integers less than 2, including negative numbers
; For non-integers, returns false
(define (prime? n)
  (if (not (integer? n))
    false
    (if (< n 2)
      false
      (let ()
        ; Check if any divisor d from 2 to sqrt(n) divides n evenly
        (define (has-divisor? d)
          (if (> (* d d) n)
            false
            (if (= (modulo n d) 0)
              true
              (has-divisor? (+ d 1)))))
        (not (has-divisor? 2))))))

; primes-up-to: (primes-up-to n) returns the list of all prime numbers <= n in ascending order
; For n < 2, returns the empty list
; Implementation: filter prime? over integers from 2 to n
(define (primes-up-to n)
  (if (< n 2)
    nil
    (filter prime? (range 2 (+ n 1)))))

; ===== DIGIT MANIPULATION FUNCTIONS =====

; digits: (digits n) returns the list of decimal digits of a non-negative integer n
; in order from most significant (left) to least significant (right).
; (digits 0) -> (0), (digits 12345) -> (1 2 3 4 5)
; Raises EvalError if n is not an integer or is negative.
(define (digits n)
  (if (not (integer? n))
    (error "digits: n must be an integer"))
  (if (< n 0)
    (error "digits: n must be non-negative"))
  ; Special case: n = 0
  (if (= n 0)
    (list 0)
    ; General case: extract digits by repeatedly taking modulo 10 and dividing by 10
    (let ()
      (define (extract-digits n acc)
        (if (= n 0)
          acc
          (extract-digits (quotient n 10) (cons (modulo n 10) acc))))
      (extract-digits n nil))))

; digit-sum: (digit-sum n) returns the sum of the decimal digits of a non-negative integer n.
; (digit-sum 12345) -> 15, (digit-sum 0) -> 0
; Raises EvalError if n is not an integer or is negative.
(define (digit-sum n)
  (if (not (integer? n))
    (error "digit-sum: n must be an integer"))
  (if (< n 0)
    (error "digit-sum: n must be non-negative"))
  (sum (digits n)))

; digital-root: (digital-root n) returns the digital root of a non-negative integer n.
; The digital root is obtained by repeatedly summing digits until a single digit (0..9) remains.
; (digital-root 12345) -> 6 (1+2+3+4+5=15, then 1+5=6)
; (digital-root 9875) -> 2 (9+8+7+5=29, then 2+9=11, then 1+1=2)
; Raises EvalError if n is not an integer or is negative.
(define (digital-root n)
  (if (not (integer? n))
    (error "digital-root: n must be an integer"))
  (if (< n 0)
    (error "digital-root: n must be non-negative"))
  ; If n is already a single digit, return it
  (if (< n 10)
    n
    ; Otherwise, recursively take the digital root of the digit-sum
    (digital-root (digit-sum n))))

; ===== LIST COMBINATORICS =====

; Helper for permutations: removes the first occurrence of x from lst
; Returns a list with x removed if found; otherwise returns lst
(define (remove-first lst x)
  (if (null? lst)
    nil
    (if (= (car lst) x)
      (cdr lst)
      (cons (car lst) (remove-first (cdr lst) x)))))

; permutations: (permutations lst) returns a list of all permutations of lst
; Each permutation is a list. The result is a list of lists.
; (permutations nil) -> (()) (a list containing one empty list)
; (permutations (list 1 2)) -> ((1 2) (2 1)) (in some order)
; For n distinct elements, there are n! permutations.
(define (permutations lst)
  (if (null? lst)
    ; Base case: empty list -> list containing one empty list
    (list nil)
    ; Recursive case: for each element in lst,
    ; prepend it to all permutations of the rest (lst without that element)
    (foldl
      (lambda (acc elem)
        (let ((rest (remove-first lst elem)))
          (let ((perms-of-rest (permutations rest)))
            (append acc (map (lambda (perm) (cons elem perm)) perms-of-rest)))))
      nil
      lst)))

; power-set: (power-set lst) returns a list of all subsets of lst
; Each subset is a list. The result is a list of lists.
; (power-set nil) -> (()) (a list containing one empty list)
; (power-set (list 1 2)) -> ((1 2) (1) (2) ()) (in some order)
; For n elements, there are 2^n subsets.
(define (power-set lst)
  (if (null? lst)
    ; Base case: empty list -> list containing one empty list
    (list nil)
    ; Recursive case: power-set of (cons x rest)
    ; = (power-set rest) + each of those subsets with x prepended
    (let ((rest-power-set (power-set (cdr lst)))
          (x (car lst)))
      (append
        rest-power-set
        (map (lambda (subset) (cons x subset)) rest-power-set)))))

; ===== COIN CHANGE =====

; coin-change: (coin-change amount coins) returns the MINIMUM number of coins
; (chosen from the list `coins` of positive integer denominations, each usable any number of times)
; that sum exactly to `amount`, or -1 if `amount` cannot be made from the given coins.
; (coin-change 0 coins) returns 0.
; Uses bottom-up dynamic programming with a mutable vector.
; Requires: `amount` must be a non-negative integer and `coins` a non-empty list of positive integers,
; else raises EvalError.
(define (coin-change amount coins)
  ; Validate inputs
  (if (not (integer? amount))
    (error "coin-change: amount must be an integer"))
  (if (< amount 0)
    (error "coin-change: amount must be non-negative"))
  (if (not (list? coins))
    (error "coin-change: coins must be a list"))
  (if (null? coins)
    (error "coin-change: coins cannot be empty"))
  ; Handle base case
  (if (= amount 0)
    0
    ; Create dp vector of length amount+1, initialize all to (amount+1) sentinel
    (let ((dp (make-vector (+ amount 1) (+ amount 1))))
      (vector-set! dp 0 0)
      ; Bottom-up DP: for each total from 1 to amount
      (dotimes (i (+ amount 1))
        (for-each
          (lambda (coin)
            (if (<= coin i)
              (let ((prev (vector-ref dp (- i coin)))
                    (current (vector-ref dp i)))
                (if (< (+ prev 1) current)
                  (vector-set! dp i (+ prev 1))))))
          coins))
      ; Return dp[amount] if reachable (<=amount), else -1
      (let ((result (vector-ref dp amount)))
        (if (<= result amount)
          result
          -1)))))

